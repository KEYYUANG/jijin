# ---------- 数据缓存 ----------
# nav_store.pkl 约 123MB，超过 GitHub 单文件 100MB 上限，绝对不能提交
cache/
backup/

# ---------- 运行产物 ----------
# 看板与 CSV 通过 Actions artifact / gh-pages 发布，不进入主分支
output/
output_*/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 临时与日志 ----------
*.log
*.tmp
.screenshots/

# ---------- 说明 ----------
# state/ 不忽略：观察池、分级、再平衡日期需要跨期保留，
# 否则每次运行都会重置观察池、失去“同一天不重复下单”的保护。
# 如果仓库要公开，注意 state/ 会暴露当前持仓与观察名单。
